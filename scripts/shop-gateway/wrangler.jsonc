{
  "name": "pantry-shop-gateway-journey",
  "main": "worker.ts",
  "compatibility_date": "2026-07-07",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "../../output/shop-gateway/assets",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/v1/*", "/test/*"],
  },
  "vars": {
    "PANTRY_PUBLIC_ORIGIN": "http://127.0.0.1:8893",
    "PANTRY_DEPLOYMENT_PROFILE": "local",
    "PANTRY_ORGANISATION_PLACEMENT_PROFILE": "{\"kind\":\"affinity\",\"placementCellId\":\"plan81-browser\",\"locationHint\":\"wnam\",\"databaseBinding\":\"DB\"}",
    "OPENROUTER_API_KEY": "synthetic-kitchen-fixture-simulated-provider",
    "PANTRY_VAULT_ACTIVE_KEY_VERSION": "v1",
    "VOICE_DNS_API_TOKEN": "synthetic-shop-voice-journey-dns-token",
    "VOICE_DNS_ZONE_ID": "shop-voice-journey-zone",
    "VOICE_DNS_ZONE_NAME": "shop-voice.test",
    "SESSION_TOKEN_SECRET": "synthetic-kitchen-fixture-session-token-secret",
  },
  "exports": {
    "OrganisationDO": { "type": "durable-object", "storage": "sqlite" },
    "SessionDO": { "type": "durable-object", "storage": "sqlite" },
    "CaseDO": { "type": "durable-object", "storage": "sqlite" },
    "ConnectorDO": { "type": "durable-object", "storage": "sqlite" },
    "CodeModePlatformGovernorActor": {
      "type": "durable-object",
      "storage": "sqlite",
    },
    "DeviceFleetActor": { "type": "durable-object", "storage": "sqlite" },
  },
  "durable_objects": {
    "bindings": [
      { "name": "ORGANISATION", "class_name": "OrganisationDO" },
      { "name": "SESSION", "class_name": "SessionDO" },
      { "name": "CASE", "class_name": "CaseDO" },
      { "name": "CONNECTOR", "class_name": "ConnectorDO" },
      {
        "name": "CODE_MODE_PLATFORM_GOVERNOR_ACTOR",
        "class_name": "CodeModePlatformGovernorActor",
      },
      { "name": "DEVICE_FLEET", "class_name": "DeviceFleetActor" },
    ],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shop-voice-journey",
      "database_id": "00000000-0000-0000-0000-000000000581",
    },
  ],
  "secrets_store_secrets": [
    {
      "binding": "DATA_ENCRYPTION_ROOT",
      "store_id": "browser-fixture",
      "secret_name": "checkpoint-root",
    },
    {
      "binding": "VAULT_ROOT_V1",
      "store_id": "browser-fixture",
      "secret_name": "vault-root",
    },
  ],
  "queues": {
    "producers": [{ "binding": "EVENT_Q", "queue": "pantry-events" }],
    "consumers": [{ "queue": "pantry-events", "max_batch_timeout": 1 }],
  },
  "kv_namespaces": [
    { "binding": "POLICY_KV", "id": "00000000000000000000000000000581" },
  ],
  "r2_buckets": [
    { "binding": "ARCHIVE", "bucket_name": "shop-voice-journey" },
  ],
}
