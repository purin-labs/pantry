  },
  "edits": [
    {
      "file": "scripts/lib/source-roots.mjs",
      "why": "the lints of the Worker source and ESLint read the Worker files of the package",
      "find": "PLATFORM_SOURCE.push(\"areas/organisation/server\");\n",
      "replace": "PLATFORM_SOURCE.push(\"areas/organisation/server\");\n// The Worker side of the area cafe (Refactor 17, Stage B).\nPLATFORM_SOURCE.push(\"areas/cafe/server\");\n"
    },
    {
      "file": "scripts/lib/source-roots.mjs",
      "why": "the Portal lints and the ESLint rules of the Portal source read the Portal files of the package",
      "find": "PORTAL_SOURCE.push(\"areas/organisation/ui\");\n",
      "replace": "PORTAL_SOURCE.push(\"areas/organisation/ui\");\n// The Portal side of the area cafe (Refactor 17, Stage B).\nPORTAL_SOURCE.push(\"areas/cafe/ui\");\n"
    }
  ],
  "keepForm": [],
  "regenerate": [
    {
      "run": [
        "node",
        "scripts/check-layers.mjs",
        "--areas",
        "--write"
      ],
      "writes": [
        "docs/layers.md"
      ]
    }
  ],
