      "file": "knip.json",
      "why": "knip reads the *.tsx files of the package and its type fixtures, and judges the exports of the ui index as the Portal did: an entry, as apps/portal/src/ui/index.ts was",
      "find": "    \"foundation/*\": {\n",
      "replace": "    \"foundation/ui\": {\n      \"entry\": [\"**/*.type-fixtures.ts\"],\n      \"project\": [\"**/*.{ts,tsx}\"]\n    },\n    \"foundation/*\": {\n"
    }
