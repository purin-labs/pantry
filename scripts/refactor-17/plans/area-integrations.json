      "services/platform/package.json",
      "apps/portal/package.json"
    ],
    "tsconfig": {
      "extends": "../../tsconfig.base.json",
      "compilerOptions": {
        "noEmit": true,
        "lib": [
          "ESNext"
        ],
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "types": [
          "@cloudflare/workers-types"
        ],
        "allowImportingTsExtensions": true
      },
      "include": [
        "server/**/*.ts"
      ]
    },
    "typeCheck": false
  },
  "edits": [
    {
      "file": "scripts/lib/source-roots.mjs",
      "why": "the lints of the Worker source and ESLint read the Worker files of the package",
      "find": "PLATFORM_SOURCE.push(\"areas/inbox/server\");\n",
      "replace": "PLATFORM_SOURCE.push(\"areas/inbox/server\");\n// The Worker side of the area integrations (Refactor 17, Stage B).\nPLATFORM_SOURCE.push(\"areas/integrations/server\");\n"
    },
    {
      "file": "scripts/lib/source-roots.mjs",
      "why": "the Portal lints and the ESLint rules of the Portal source read the Portal files of the package",
      "find": "PORTAL_SOURCE.push(\"areas/inbox/ui\");\n",
      "replace": "PORTAL_SOURCE.push(\"areas/inbox/ui\");\n// The Portal side of the area integrations (Refactor 17, Stage B).\nPORTAL_SOURCE.push(\"areas/integrations/ui\");\n"
    }
  ],
  "keepForm": [],
  "regenerate": [
    {
      "run": [
        "node",
        "scripts/check-layers.mjs",
        "--areas",
        "--write"
      ],
      "writes": [
        "docs/layers.md"
      ]
    }
  ],
