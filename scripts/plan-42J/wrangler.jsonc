{
  "name": "satyr-plan42j-brain-acceptance",
  "main": "brain-worker.ts",
  "compatibility_date": "2026-07-07",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "PANTRY_PUBLIC_ORIGIN": "http://127.0.0.1:3142",
    "PANTRY_DEPLOYMENT_PROFILE": "local",
    "PANTRY_ORGANISATION_PLACEMENT_PROFILE": "{\"kind\":\"affinity\",\"placementCellId\":\"plan42j-browser\",\"locationHint\":\"wnam\",\"databaseBinding\":\"DB\"}",
    "OPENROUTER_API_KEY": "synthetic-brain-fixture-simulated-provider",
    "PANTRY_VAULT_ACTIVE_KEY_VERSION": "v1",
    "SESSION_TOKEN_SECRET": "synthetic-brain-fixture-session-token-secret",
    // The built account Worker of the acceptance tests. The provider process
    // runs it, binds it as ACCOUNT_PLATFORM and adds the two keys of each run.
    "ACCOUNT_PLATFORM_DEPLOYMENT_ID": "shared-account-satyr-e2e",
    "ACCOUNT_PLATFORM_PROVISION_TOKEN": "shared-account-e2e-pantry-provision",
    "ACCOUNT_PLATFORM_PROVISION_ASSERTION_KEY_ID": "account-shared-account-e2e",
    "ACCOUNT_PLATFORM_PROVISION_ASSERTION_ISSUER": "https://account.shared-account.invalid",
    "ACCOUNT_PLATFORM_PROVISION_ASSERTION_AUDIENCE": "https://satyr.shared-account.invalid",
    "ACCOUNT_PLATFORM_USER_ASSERTION_KEY_ID": "satyr-shared-account-e2e",
    "ACCOUNT_PLATFORM_ASSERTION_ISSUER": "https://satyr.shared-account.invalid",
    "ACCOUNT_PLATFORM_ASSERTION_AUDIENCE": "https://account.shared-account.invalid",
    "GOOGLE_OIDC_CLIENT_ID": "shared-account-satyr-e2e",
  },
  "exports": {
    "OrganisationDO": { "type": "durable-object", "storage": "sqlite" },
    "SessionDO": { "type": "durable-object", "storage": "sqlite" },
    "CaseDO": { "type": "durable-object", "storage": "sqlite" },
    "ConnectorDO": { "type": "durable-object", "storage": "sqlite" },
    "CodeModePlatformGovernorActor": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
  "durable_objects": {
    "bindings": [
      { "name": "ORGANISATION", "class_name": "OrganisationDO" },
      { "name": "SESSION", "class_name": "SessionDO" },
      { "name": "CASE", "class_name": "CaseDO" },
      { "name": "CONNECTOR", "class_name": "ConnectorDO" },
      {
        "name": "CODE_MODE_PLATFORM_GOVERNOR_ACTOR",
        "class_name": "CodeModePlatformGovernorActor",
      },
    ],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "plan42j-brain-acceptance",
      "database_id": "00000000-0000-0000-0000-000000000426",
    },
  ],
  "secrets_store_secrets": [
    {
      "binding": "DATA_ENCRYPTION_ROOT",
      "store_id": "browser-fixture",
      "secret_name": "checkpoint-root"
    },
    {
      "binding": "VAULT_ROOT_V1",
      "store_id": "browser-fixture",
      "secret_name": "vault-root"
    }
  ],
  "queues": {
    "producers": [{ "binding": "EVENT_Q", "queue": "satyr-events" }],
    "consumers": [{ "queue": "satyr-events", "max_batch_timeout": 1 }],
  },
  "kv_namespaces": [
    { "binding": "POLICY_KV", "id": "00000000000000000000000000000426" },
  ],
  "r2_buckets": [
    { "binding": "ARCHIVE", "bucket_name": "plan42j-brain-acceptance" },
  ],
}
