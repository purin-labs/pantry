{
  "display_information": {
    "name": "Seams Pantry Local",
    "description": "Bakery operating system"
  },
  "features": {
    "bot_user": {
      "display_name": "sous-chef",
      "always_online": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "channels:history",
        "channels:read",
        "groups:history",
        "groups:read",
        "im:history",
        "chat:write",
        "files:read"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "app_uninstalled",
        "app_mention",
        "message.channels",
        "message.groups",
        "message.im",
        "tokens_revoked"
      ]
    },
    "socket_mode_enabled": false,
    "org_deploy_enabled": false,
    "token_rotation_enabled": false
  }
}
