{
  // The standalone demo shop on Commerce (Plan 40B, decision 8), and the
  // QR order pages at `<MENU_HOST>/<shop name>/` (Plan 40B phase 2).
  // Deploy with `pnpm --filter @purin-labs/storefront deploy:shop`, with
  // VITE_SHOP_MERCHANT_ID set to the merchant of the shop.
  // Both addresses are custom domains, so Cloudflare makes their DNS records
  // and certificates; the release guard (`WORKER_DOMAINS` in
  // scripts/worker-environment.mjs) allows these two routes only.
  "$schema": "../../services/commerce/node_modules/wrangler/config-schema.json",
  "name": "purin-shop",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-07",
  "observability": {
    "enabled": true,
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // An order page host needs the Worker for every request: it checks the
    // shop name before it serves a page.
    "run_worker_first": true,
  },
  "services": [{ "binding": "COMMERCE", "service": "pantry-commerce" }],
  "vars": { "MENU_HOST": "menu.purin.io" },
  "routes": [
    { "pattern": "shop.purin.io", "custom_domain": true },
    { "pattern": "menu.purin.io", "custom_domain": true },
  ],
  "workers_dev": false,
  "preview_urls": false,
}
