/*
  Cross-Origin-Opener-Policy: same-origin-allow-popups

# Each folder name below is a content hash, and the client checks the SHA-256
# of every file that it uses, so a file at one of these paths never changes
# (Refactor 16, step 11).
/bakery-physics/bundles/*
  Cache-Control: public, max-age=31536000, immutable

/bakery-physics/executions/*
  Cache-Control: public, max-age=31536000, immutable

/bakery-physics/visuals/*
  Cache-Control: public, max-age=31536000, immutable
