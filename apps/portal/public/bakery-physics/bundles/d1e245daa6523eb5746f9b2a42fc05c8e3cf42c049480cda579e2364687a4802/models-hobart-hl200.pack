    <general name="mix_lift_fixture" joint="mix_lift" ctrlrange="-0.02 0" forcerange="-1000 1000" input="pos" biastype="affine" gainprm="120000" biasprm="0 -120000 -1500" />
    <general name="mix_guard_fixture" joint="mix_guard" ctrlrange="-2.0943950999999998 0" forcerange="-60 60" input="pos" biastype="affine" gainprm="60" biasprm="0 -60 -12" />
  </actuator>
  <sensor>
    <jointpos joint="mix_orbit" name="mix_orbit_position" />
    <jointvel joint="mix_orbit" name="mix_orbit_velocity" />
    <jointpos joint="mix_spin" name="mix_spin_position" />
    <jointvel joint="mix_spin" name="mix_spin_velocity" />
    <jointpos joint="mix_guard" name="mix_guard_position" />
    <jointvel joint="mix_guard" name="mix_guard_velocity" />
    <jointpos joint="mix_lift" name="mix_lift_position" />
    <jointvel joint="mix_lift" name="mix_lift_velocity" />
  </sensor>
  <custom>
    <numeric name="mix_speed_settings_rpm" size="4" data="59 107 198 365" />
    <numeric name="mix_lift_travel" size="1" data="0.02" />
    <numeric name="mix_guard_open" size="1" data="-2.0943951023931953" />
    <numeric name="mix_gear_ratio" size="1" data="-4" />
  </custom>
</mujoco>
