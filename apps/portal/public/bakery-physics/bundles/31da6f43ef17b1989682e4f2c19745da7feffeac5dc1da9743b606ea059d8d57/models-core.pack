      <geom name="po_kettle_stand" pos="0.62 -0.22 0.815" size="0.07 0.07 0.015" rgba="0.2 0.21 0.22 1" />
    </body>
    <!-- One load cell under the platen: a stiff spring the scale reads. -->
    <body name="po_scale_platen" pos="0.62 0.17 0.826">
      <joint name="po_scale_cell" type="slide" axis="0 0 1" stiffness="200000" damping="900" range="-0.002 0.002" />
