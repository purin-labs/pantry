<mujoco model="Assumed two-finger kettle gripper">
  <compiler angle="radian" autolimits="true" />
  <default>
    <default class="po_finger">
      <!-- Stiff rubber pads; the contact solver gives them priority over the handle. -->
      <geom type="box" rgba="0.12 0.38 0.4 1" friction="1 0.01 0.0001" condim="4" solref="0.004 1" solimp="0.99 0.999 0.001 0.5 2" priority="1" />
      <joint type="slide" range="-0.003 0.03" damping="8" armature="0.002" frictionloss="0.2" />
    </default>
  </default>
  <worldbody>
    <!-- Tool X extends from the flange; fingers close along tool Y. -->
    <body name="po_gripper" quat="0 0.7071067811865476 0 0.7071067811865476">
      <geom name="po_grip_adapter" type="cylinder" pos="0.012 0 0" quat="0.7071067811865476 0 0.7071067811865476 0" size="0.04 0.012" mass="0.3" rgba="0.65 0.7 0.72 1" />
      <geom name="po_grip_palm" type="box" pos="0.045 0 0" size="0.015 0.05 0.03" mass="0.45" rgba="0.12 0.38 0.4 1" />
      <site name="po_tool_grasp" pos="0.13 0 0" size="0.006" group="3" />
      <body name="po_finger_left" pos="0 0.014 0" childclass="po_finger">
        <joint name="po_finger_left_slide" axis="0 1 0" />
        <geom name="po_finger_left_link" pos="0.084 0.004 0" size="0.024 0.004 0.012" mass="0.06" />
        <geom name="po_finger_left_pad" pos="0.13 0 0" size="0.016 0.005 0.025" mass="0.04" rgba="0.12 0.14 0.14 1" contype="0" conaffinity="0" />
        <!-- Two vertical rubber ribs grip the flat handle: box-capsule contact stays robust. -->
        <geom name="po_finger_left_pad_front" type="capsule" fromto="0.138 -0.004 -0.022 0.138 -0.004 0.022" size="0.002" mass="0.002" rgba="0.08 0.09 0.09 1" />
        <geom name="po_finger_left_pad_back" type="capsule" fromto="0.122 -0.004 -0.022 0.122 -0.004 0.022" size="0.002" mass="0.002" rgba="0.08 0.09 0.09 1" />
      </body>
      <body name="po_finger_right" pos="0 -0.014 0" childclass="po_finger">
        <joint name="po_finger_right_slide" axis="0 -1 0" />
        <geom name="po_finger_right_link" pos="0.084 -0.004 0" size="0.024 0.004 0.012" mass="0.06" />
        <geom name="po_finger_right_pad" pos="0.13 0 0" size="0.016 0.005 0.025" mass="0.04" rgba="0.12 0.14 0.14 1" contype="0" conaffinity="0" />
        <geom name="po_finger_right_pad_front" type="capsule" fromto="0.138 0.004 -0.022 0.138 0.004 0.022" size="0.002" mass="0.002" rgba="0.08 0.09 0.09 1" />
        <geom name="po_finger_right_pad_back" type="capsule" fromto="0.122 0.004 -0.022 0.122 0.004 0.022" size="0.002" mass="0.002" rgba="0.08 0.09 0.09 1" />
      </body>
    </body>
  </worldbody>
  <actuator>
    <position name="po_finger_left_servo" joint="po_finger_left_slide" kp="4000" kv="30" forcelimited="true" forcerange="-40 40" ctrllimited="true" ctrlrange="-0.01 0.03" />
    <position name="po_finger_right_servo" joint="po_finger_right_slide" kp="4000" kv="30" forcelimited="true" forcerange="-40 40" ctrllimited="true" ctrlrange="-0.01 0.03" />
  </actuator>
</mujoco>
<mujoco model="Robotic pour-over station">
  <!-- Estimated geometry, masses and contact parameters; see README.md. -->
  <compiler angle="radian" autolimits="true" />
  <!-- No-slip iterations remove the soft-contact creep of a friction grip. -->
  <option timestep="0.002" integrator="implicitfast" gravity="0 0 -9.81" cone="elliptic" noslip_iterations="4" />
  <default>
    <geom friction="0.6 0.005 0.0001" />
    <default class="po_steel">
      <geom type="box" rgba="0.55 0.62 0.64 1" />
    </default>
    <default class="po_visual">
      <geom contype="0" conaffinity="0" group="1" />
    </default>
  </default>
  <worldbody>
    <light pos="-1 -2 4" dir="0.2 0.3 -1" />
    <geom name="cell_floor" type="plane" size="2.5 2 0.1" rgba="0.18 0.22 0.25 1" />
