      <geom name="po_scale_platen_top" type="box" size="0.09 0.09 0.004" rgba="0.72 0.74 0.75 1" contype="2" conaffinity="2" friction="0.8 0.005 0.0001" />
    </body>
    <!-- Glass server: the receiving vessel. Origin at its outer base centre. -->
