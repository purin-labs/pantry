# Vite loads this for `vite build`, which is how the deployed portal is built.
# Without it the console's Docs link falls back to the localhost default in
# shell.tsx and ships pointing at a dev server nobody else can reach.
#
# This holds no secret: it is a public documentation origin, inlined into the
# client bundle like every other VITE_ value.
VITE_DOCS_ORIGIN=https://satyr-docs.n6378056.workers.dev
