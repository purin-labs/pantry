{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-07",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "dev": {
    "ip": "127.0.0.1",
    "port": 3102,
    "inspector_port": 9232,
  },
  "observability": {
    "enabled": true,
  },
  "exports": {
    "UnderclerkMerchantDO": {
      "type": "durable-object",
      "storage": "sqlite",
    },
    // One object for each shop name (Plan 40B phase 2).
    "UnderclerkShopNameDO": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
  "env": {
    "local": {
      "name": "underclerk",
      "vars": {
        "PANTRY_DEPLOYMENT_PROFILE": "local",
        "UNDERCLERK_SIGNING_KEY_ID": "key_underclerk_v1",
      },
      "secrets": {
        "required": [
          "JAPAN_CARRIER_SIGNING_KEY",
          "UNDERCLERK_BUYER_SESSION_SECRET",
          "UNDERCLERK_SERVICE_TOKEN",
          "UNDERCLERK_SIGNING_PRIVATE_KEY_PKCS8_B64",
        ],
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "UNDERCLERK_MERCHANT",
            "class_name": "UnderclerkMerchantDO",
          },
          {
            "name": "UNDERCLERK_SHOP_NAME",
            "class_name": "UnderclerkShopNameDO",
          },
        ],
      },
      // Simulated by `wrangler dev`; no bucket of this name exists.
      "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "underclerk-local" }],
    },
    "production": {
      "name": "underclerk",
      "vars": {
        "UNDERCLERK_SIGNING_KEY_ID": "key_underclerk_v1",
        "PANTRY_DEPLOYMENT_PROFILE": "production",
        "SHOP_SITE_ORIGIN": "https://shop.seams.tokyo",
      },
      "secrets": {
        "required": [
          "UNDERCLERK_SERVICE_TOKEN",
          "UNDERCLERK_BUYER_SESSION_SECRET",
          "UNDERCLERK_SIGNING_PRIVATE_KEY_PKCS8_B64",
          "JAPAN_CARRIER_SIGNING_KEY",
        ],
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "UNDERCLERK_MERCHANT",
            "class_name": "UnderclerkMerchantDO",
          },
          {
            "name": "UNDERCLERK_SHOP_NAME",
            "class_name": "UnderclerkShopNameDO",
          },
        ],
      },
      // Archived orders and events and product image bytes (APAC hint).
      "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "underclerk-apac" }],
      // Optional (Plan 76 phase 3): STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET
      // as secrets and STRIPE_PUBLISHABLE_KEY as a variable let Commerce run
      // the Stripe payments of connected accounts. Without them every Stripe
      // payment is refused as unavailable.
    },
  },
}
