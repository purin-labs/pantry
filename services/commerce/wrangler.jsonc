{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-07",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Plan 93: the Worker has one address, its custom domain on purin.io.
  "workers_dev": false,
  "preview_urls": false,
  "dev": {
    "ip": "127.0.0.1",
    "port": 3102,
    "inspector_port": 9232,
  },
  "observability": {
    "enabled": true,
  },
  "exports": {
    "CommerceMerchantDO": {
      "type": "durable-object",
      "storage": "sqlite",
    },
    // One object for each shop name (Plan 40B phase 2).
    "CommerceShopNameDO": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
  "env": {
    "local": {
      "name": "pantry-commerce",
      "vars": {
        "PANTRY_DEPLOYMENT_PROFILE": "local",
        "COMMERCE_SIGNING_KEY_ID": "key_commerce_v1",
      },
      "secrets": {
        "required": [
          "JAPAN_CARRIER_SIGNING_KEY",
          "COMMERCE_BUYER_SESSION_SECRET",
          "COMMERCE_SERVICE_TOKEN",
          "COMMERCE_SIGNING_PRIVATE_KEY_PKCS8_B64",
        ],
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "COMMERCE_MERCHANT",
            "class_name": "CommerceMerchantDO",
          },
          {
            "name": "COMMERCE_SHOP_NAME",
            "class_name": "CommerceShopNameDO",
          },
        ],
      },
      // Simulated by `wrangler dev`; no bucket of this name exists.
      "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "pantry-commerce-local" }],
    },
    "production": {
      "name": "pantry-commerce",
      "routes": [
        { "pattern": "commerce.pantry.purin.io", "custom_domain": true },
      ],
      "vars": {
        "COMMERCE_SIGNING_KEY_ID": "key_commerce_v1",
        "PANTRY_DEPLOYMENT_PROFILE": "production",
        "SHOP_SITE_ORIGIN": "https://shop.purin.io",
      },
      "secrets": {
        "required": [
          "COMMERCE_SERVICE_TOKEN",
          "COMMERCE_BUYER_SESSION_SECRET",
          "COMMERCE_SIGNING_PRIVATE_KEY_PKCS8_B64",
          "JAPAN_CARRIER_SIGNING_KEY",
        ],
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "COMMERCE_MERCHANT",
            "class_name": "CommerceMerchantDO",
          },
          {
            "name": "COMMERCE_SHOP_NAME",
            "class_name": "CommerceShopNameDO",
          },
        ],
      },
      // Archived orders and events and product image bytes (APAC hint).
      "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "pantry-commerce-apac" }],
      // Optional (Plan 76 phase 3): STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET
      // as secrets and STRIPE_PUBLISHABLE_KEY as a variable let Commerce run
      // the Stripe payments of connected accounts. Without them every Stripe
      // payment is refused as unavailable.
    },
  },
}
