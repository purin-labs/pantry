{
  "name": "@seams/platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare-native Satyr platform and control plane.",
  "scripts": {
    "check:types": "pnpm contracts:media && pnpm actions:check && tsrs --noEmit",
    "check:test-types": "tsrs -p tsconfig.tests.json && tsrs -p tsconfig.e2e.json",
    "actions:generate": "node --experimental-strip-types scripts/generate-actions.ts",
    "actions:check": "node --experimental-strip-types scripts/generate-actions.ts --check",
    "audit:credential-closure": "pnpm exec esbuild scripts/audit-credential-closure.ts --bundle --platform=node --format=esm --outfile=/tmp/satyr-audit-credential-closure.mjs --log-level=warning && node /tmp/satyr-audit-credential-closure.mjs",
    "audit:credential-closure:remote": "pnpm exec esbuild scripts/audit-credential-closure.ts --bundle --platform=node --format=esm --outfile=/tmp/satyr-audit-credential-closure.mjs --log-level=warning && node /tmp/satyr-audit-credential-closure.mjs --remote",
    "test": "vitest run",
    "test:e2e": "pnpm contracts:media && vitest run --config vitest.e2e.config.ts",
    "test:migrations": "vitest run tests/d1-schema.test.ts",
    "test:onboarding-closure": "vitest run tests/integration-account.test.ts tests/onboarding/safety.test.ts tests/onboarding-activation.test.ts tests/onboarding-reconciliation.test.ts tests/provider-attempt.test.ts tests/control-mutation.test.ts tests/onboarding-projection.test.ts tests/provider-resource.test.ts tests/account-removal.test.ts",
    "test:commerce-lab": "vitest run tests/commerce-lab tests/commerce-entity-plane-route.test.ts tests/ingress-queue.test.ts tests/cue-engine.test.ts",
    "test:m6-recovery": "vitest run tests/fault-injection-auth.test.ts tests/session-turn-stream.test.ts",
    "deploy": "pnpm --filter @seams/async-control build && pnpm contracts:media && bash ../shop-gateway/build.sh && pnpm --filter @seams/portal build && pnpm d1:schema:remote:check && pnpm slack-ingress:check && pnpm model-exit:check && pnpm chatgpt-exit:check && pnpm vault-onepassword:check && pnpm code-mode-sandbox:deploy && pnpm model-exit:deploy && pnpm chatgpt-exit:deploy && pnpm vault-onepassword:deploy && node ../../scripts/run-worker.mjs platform deploy production && pnpm slack-ingress:deploy",
    "code-mode-sandbox:check": "node ../../scripts/code-mode-sandbox-worker.mjs check",
    "code-mode-sandbox:deploy": "node ../../scripts/code-mode-sandbox-worker.mjs deploy",
    "model-exit:check": "node ../../scripts/model-exit-worker.mjs check",
    "model-exit:deploy": "node ../../scripts/model-exit-worker.mjs deploy",
    "chatgpt-exit:check": "node ../../scripts/chatgpt-exit-worker.mjs check",
    "chatgpt-exit:deploy": "node ../../scripts/chatgpt-exit-worker.mjs deploy",
    "vault-onepassword:prepare": "node ../../scripts/vault-onepassword-worker.mjs prepare",
    "vault-onepassword:check": "node ../../scripts/vault-onepassword-worker.mjs check",
    "vault-onepassword:deploy": "node ../../scripts/vault-onepassword-worker.mjs deploy",
    "slack-ingress:check": "node ../../scripts/slack-ingress-worker.mjs check",
    "slack-ingress:deploy": "node ../../scripts/slack-ingress-worker.mjs deploy",
    "dev": "node ../../scripts/run-worker.mjs platform dev local",
    "d1:migrate:local": "node ../../scripts/run-worker.mjs platform migrate local",
    "d1:schema:remote:check": "node ../../scripts/run-worker.mjs platform schema production",
    "canary:plan37": "node --experimental-strip-types scripts/plan37-attachment-canary.ts",
    "slack:live-reply": "node --experimental-strip-types scripts/slack-live-reply-journey.ts",
    "contracts:media": "pnpm --filter @seams/contracts media:build"
  },
  "dependencies": {
    "@1password/sdk": "0.5.0",
    "@cloudflare/containers": "^0.3.7",
    "@earendil-works/chord": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-codemode": "1.5.0",
    "@earendil-works/pi-durable": "1.5.0",
    "@earendil-works/pi-mcp": "1.5.0",
    "@earendil-works/pi-schema": "1.5.0",
    "@seams/async-control": "workspace:*",
    "@seams/bakery-model": "workspace:*",
    "@seams/bakery-workflow": "workspace:*",
    "@seams/collaboration": "workspace:*",
    "@seams/contracts": "workspace:*",
    "@seams/control-api": "workspace:*",
    "@seams/costs-sheet-crdt": "workspace:*",
    "@seams/email-draft-crdt": "workspace:*",
    "@seams/mail-reply-crdt": "workspace:*",
    "@seams/menu-board-crdt": "workspace:*",
    "@seams/menu-draft-crdt": "workspace:*",
    "@seams/product-description-crdt": "workspace:*",
    "@seams/production-plan-crdt": "workspace:*",
    "@seams/production-simulation": "workspace:*",
    "@seams/std": "workspace:*",
    "@seams/type-utils": "workspace:*",
    "@seams/workflow-canvas-crdt": "workspace:*",
    "@seams-internal/console-shared": "file:../../vendor/seams/seams-internal-console-shared-0.1.3-ebed186cf39a.tgz",
    "@seams/commerce-client": "workspace:*",
    "@seams/commerce-query-sqlite": "workspace:*",
    "@seams/commerce-contracts": "workspace:*",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "yjs": "13.6.32",
    "@cloudflare/vitest-plugin": "1.0.0",
    "@cloudflare/workers-types": "5.20260707.1",
    "@msw/cloudflare": "0.0.1",
    "@types/node": "25.9.3",
    "esbuild": "0.28.1",
    "miniflare": "4.20260701.0",
    "msw": "2.15.0",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "5.9.3",
    "vite": "8.0.16",
    "vitest": "4.1.9",
    "wrangler": "4.107.0"
  }
}
