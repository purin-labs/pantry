{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The Slack ingress Worker. It holds the fast path of a Slack event and no
  // Actor class, so a new isolate of it starts sooner than one of the
  // platform Worker. It calls the Connector class of the platform Worker and
  // passes every other request to the platform Worker.
  //
  // The values that it shares with the production profile of wrangler.jsonc
  // must be equal. `pnpm --filter @purin-labs/platform slack-ingress:deploy` refuses a
  // deployment when they differ, and when the script holds platform code.
  "main": "src/slack-ingress/worker.ts",
  "compatibility_date": "2026-07-07",
  "compatibility_flags": ["nodejs_compat"],
  "minify": true,
  // Plan 93: the Worker has one address, its custom domain on purin.io.
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
  },
  "env": {
    "production": {
      "name": "pantry-slack-ingress",
      "routes": [{ "pattern": "slack.pantry.purin.io", "custom_domain": true }],
      // Slack sends its events from the east of North America, so the edge
      // that receives them is far from the route database and from the
      // Connectors, which are in Tokyo. The handler therefore runs near the
      // databases. The event then crosses the Pacific one time. From the
      // edge, the route read and the Connector call each crossed it and came
      // back.
      "placement": {
        "region": "aws:ap-northeast-1",
      },
      "vars": {
        "PANTRY_DEPLOYMENT_PROFILE": "production",
        "PANTRY_ORGANISATION_PLACEMENT_PROFILE": "{\"kind\":\"affinity\",\"placementCellId\":\"production-apac\",\"locationHint\":\"apac\",\"databaseBinding\":\"ORGANISATION_DB_APAC\"}",
        "PANTRY_VAULT_ACTIVE_KEY_VERSION": "v1",
        "SLACK_APP_ID": "A0BFVDZLFLM",
      },
      // SLACK_SIGNING_SECRET is a Worker secret: a copy of the secret of
      // the platform Worker. Without it, or with an outdated copy, this
      // Worker passes every request to the platform Worker.
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "pantry-global-apac",
          "database_id": "ced3f859-6a2b-4e54-bc8e-92d2dae424fa",
        },
        {
          "binding": "ORGANISATION_DB_APAC",
          "database_name": "pantry-organisation-apac",
          "database_id": "130a94eb-71a6-40a9-991d-b359f36a939a",
        },
      ],
      "secrets_store_secrets": [
        {
          "binding": "VAULT_ROOT_V1",
          "store_id": "41fe2fa0a4a64d25a120a6c00973da1d",
          "secret_name": "pantry-vault-root",
        },
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "CONNECTOR",
            "class_name": "ConnectorDO",
            "script_name": "pantry",
          },
        ],
      },
      "services": [
        {
          "binding": "PLATFORM",
          "service": "pantry",
        },
      ],
    },
  },
}
