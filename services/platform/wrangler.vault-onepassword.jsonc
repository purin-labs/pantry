{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The 1Password store Worker (Plan 79). The Platform Worker sends each
  // Vault operation of an Organisation that keeps its items in 1Password
  // here, with that Organisation's service account token, and this Worker
  // runs it with the 1Password SDK. The SDK core is a 14 MB Wasm module, so
  // it lives here and not in the Platform Worker.
  //
  // It has no route, no credential and no binding except its profile
  // variable. The Platform Worker reaches it through the service binding
  // VAULT_ONEPASSWORD. Deploy this Worker before the platform Worker that
  // binds it. `pnpm --filter @seams/platform vault-onepassword:check` prepares the
  // SDK loader and checks this profile.
  "main": "src/vault-onepassword/worker.ts",
  "compatibility_date": "2026-07-07",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  // The SDK reads its core from the file system; the prepared loader takes
  // the module that the Worker imports instead.
  "alias": {
    "@1password/sdk-core": "./.generated/vault-onepassword/core.cjs",
  },
  // Near AWS Tokyo, as the other exit Workers. Never use Smart Placement.
  "placement": {
    "region": "aws:ap-northeast-1",
  },
  "observability": {
    "enabled": true,
    // Cloudflare's invocation record would keep each request, which holds a
    // service account token and item values.
    "logs": {
      "invocation_logs": false,
    },
  },
  "env": {
    "local": {
      "name": "satyr-vault-onepassword-local",
      "vars": { "SATYR_DEPLOYMENT_PROFILE": "local" },
    },
    "staging": {
      "name": "satyr-vault-onepassword-staging",
      "vars": { "SATYR_DEPLOYMENT_PROFILE": "staging" },
    },
    "production": {
      "name": "satyr-vault-onepassword",
      "vars": { "SATYR_DEPLOYMENT_PROFILE": "production" },
    },
  },
}
