{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/recipes/bakery/**",
    "src/recipes/*/model.ts",
    "src/recipes/pour-over/sample.ts",
    "src/runs/**",
    "src/floor/**",
    "src/simulator/**",
    "src/execution-manifest.generated.ts"
  ]
}
