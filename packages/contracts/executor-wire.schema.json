{
  "WorkspaceExecutorPreparationRequestWire": {
    "type": "object",
    "required": [
      "schemaVersion",
      "preparationId",
      "identity",
      "limits",
      "deadlineAtUnixMs",
      "operation"
    ],
    "properties": {
      "schemaVersion": {
        "type": "string",
        "const": "workspace_executor_preparation.v1"
      },
      "preparationId": { "type": "string" },
      "identity": {
        "type": "object",
        "required": [
          "organisationId",
          "sessionId",
          "turnId",
          "attachmentId",
          "sourceSha256",
          "handlerRevision"
        ],
        "properties": {
          "organisationId": { "type": "string" },
          "sessionId": { "type": "string" },
          "turnId": { "type": "string" },
          "attachmentId": {
            "type": "string",
            "pattern": "^att_[0-9a-z]{1,64}$"
          },
          "sourceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "handlerRevision": { "type": "string" }
        },
        "additionalProperties": false,
        "title": "PreparationIdentity",
        "x-rust-type": "crate::contracts::MessageAttachmentPreparationIdentity"
      },
      "limits": {
        "type": "object",
        "required": [
          "maxInputBytes",
          "maxOutputBytes",
          "maxDurationMs",
          "maxFrames"
        ],
        "properties": {
          "maxInputBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "maxOutputBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "maxDurationMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "maxFrames": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "additionalProperties": false,
        "title": "PreparationLimits",
        "x-rust-type": "crate::contracts::MessageAttachmentPreparationLimits"
      },
      "deadlineAtUnixMs": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "operation": {
        "type": "object",
        "required": [
          "kind",
          "mediaClass",
          "mediaType",
          "byteLength",
          "maxTextChars"
        ],
        "properties": {
          "kind": { "type": "string", "const": "prepare_message_attachment" },
          "mediaClass": {
            "enum": ["document", "audio", "video", "opaque"],
            "title": "AttachmentMediaClassWire"
          },
          "mediaType": { "type": "string" },
          "byteLength": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "maxTextChars": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          }
        },
        "additionalProperties": false,
        "title": "WorkspaceExecutorPreparationOperationWire"
      }
    },
    "additionalProperties": false
  },
  "WorkspaceExecutorPreparationResponse": {
    "type": "object",
    "required": [
      "schemaVersion",
      "preparationId",
      "identity",
      "operation",
      "inputBytes",
      "outputBytes",
      "durationMs"
    ],
    "properties": {
      "schemaVersion": {
        "type": "string",
        "const": "workspace_executor_response.v1"
      },
      "preparationId": { "type": "string" },
      "identity": {
        "type": "object",
        "required": [
          "organisationId",
          "sessionId",
          "turnId",
          "attachmentId",
          "sourceSha256",
          "handlerRevision"
        ],
        "properties": {
          "organisationId": { "type": "string" },
          "sessionId": { "type": "string" },
          "turnId": { "type": "string" },
          "attachmentId": {
            "type": "string",
            "pattern": "^att_[0-9a-z]{1,64}$"
          },
          "sourceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "handlerRevision": { "type": "string" }
        },
        "additionalProperties": false,
        "title": "PreparationIdentity",
        "x-rust-type": "crate::contracts::MessageAttachmentPreparationIdentity"
      },
      "operation": {
        "anyOf": [
          {
            "type": "object",
            "required": [
              "kind",
              "attachmentId",
              "text",
              "truncated",
              "sourceSha256"
            ],
            "properties": {
              "kind": { "type": "string", "const": "attachment_text" },
              "attachmentId": { "type": "string" },
              "text": { "type": "string" },
              "truncated": { "type": "boolean" },
              "sourceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "kind",
              "attachmentId",
              "policyRevision",
              "selectedTimestampsMs",
              "frames",
              "omittedFrames",
              "sourceSha256"
            ],
            "properties": {
              "kind": { "type": "string", "const": "attachment_video_frames" },
              "attachmentId": { "type": "string" },
              "policyRevision": { "type": "string" },
              "selectedTimestampsMs": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "frames": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "timestampMs",
                    "width",
                    "height",
                    "mediaType",
                    "jpegBase64",
                    "sha256"
                  ],
                  "properties": {
                    "timestampMs": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "width": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4294967295
                    },
                    "height": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4294967295
                    },
                    "mediaType": { "type": "string" },
                    "jpegBase64": { "type": "string" },
                    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
                  },
                  "additionalProperties": false,
                  "title": "DecodedVideoFrame"
                }
              },
              "omittedFrames": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "sourceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["kind", "attachmentId", "reason", "sourceSha256"],
            "properties": {
              "kind": {
                "type": "string",
                "const": "attachment_not_inspectable"
              },
              "attachmentId": { "type": "string" },
              "reason": {
                "enum": [
                  "handler_unavailable",
                  "format_unreadable",
                  "codec_unsupported",
                  "picture_too_large"
                ],
                "title": "AttachmentInspectionLimit"
              },
              "sourceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            },
            "additionalProperties": false
          }
        ],
        "title": "WorkspaceExecutorInspectionOperation"
      },
      "inputBytes": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "outputBytes": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "durationMs": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "additionalProperties": false
  }
}
