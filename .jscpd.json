{
  "path": [
    "apps",
    "areas",
    "foundation",
    "packages",
    "services",
    "surfaces",
    "crates"
  ],
  "format": ["typescript", "tsx", "javascript", "jsx", "rust"],
  "minTokens": 70,
  "mode": "weak",
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/target/**",
    "**/.wrangler/**",
    "**/public/**",
    "**/generated/**",
    "**/*.generated.*",
    "**/tests/**",
    "**/test/**",
    "**/*.test.*",
    "**/scripts/**"
  ]
}
