{
  "name": "seams-pantry",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "site": "node scripts/run-local-sites.mjs",
    "portal": "pnpm --filter @seams/portal dev --host 127.0.0.1 --port 3103 --strictPort",
    "backend": "node scripts/run-local-commerce.mjs",
    "benchmark:optimization-1": "node scripts/benchmark-optimization-1.mjs",
    "benchmark:optimization-1:smoke": "node scripts/benchmark-optimization-1.mjs --smoke",
    "proxy:reload": "caddy validate --config Caddyfile && caddy reload --config Caddyfile",
    "local:init": "node scripts/init-local-commerce-env.mjs",
    "plan21:browser": "node scripts/plan21/browser-acceptance.mjs",
    "bakery:browser": "node scripts/bakery-robots/browser-acceptance.mjs",
    "frontend:journeys": "node scripts/frontend-foundation/browser-journeys.mjs",
    "portal:build": "pnpm --filter @seams/portal build",
    "docs:dev": "pnpm --filter @seams/docs dev",
    "docs:build": "pnpm --filter @seams/docs build",
    "docs:check": "pnpm --filter @seams/docs type-check && pnpm --filter @seams/docs check:links && pnpm --filter @seams/docs check:fences",
    "docs:deploy": "pnpm --filter @seams/docs run deploy",
    "storefront:build": "pnpm --filter @seams/storefront build",
    "underclerk:check": "pnpm --filter @seams/commerce-contracts check:types && pnpm --filter @seams/commerce-client check:types && pnpm --filter @seams/commerce-worker check:types",
    "underclerk:test": "pnpm --filter @seams/commerce-worker test",
    "underclerk:verify-standalone": "node scripts/plan-76/verify-standalone-commerce.mjs",
    "async-control:build": "pnpm --filter @seams/async-control build",
    "async-control:check": "pnpm --filter @seams/async-control typecheck && pnpm --filter @seams/async-control test && pnpm --filter @seams/async-control test:exports",
    "slack:env:init": "node scripts/slack/init-local-env.mjs",
    "slack:config-token:import": "node --env-file-if-exists=.env.local scripts/slack/ensure-app-config-token.mjs --environment production --import --env-file .env.local",
    "slack:config-token:refresh": "node --env-file-if-exists=.env.local scripts/slack/ensure-app-config-token.mjs --environment production --env-file .env.local",
    "slack:cli:setup": "pnpm slack:config-token:import && node --env-file=.env.local scripts/slack/login-slack-cli.mjs",
    "slack:cli:login": "pnpm slack:config-token:refresh && node --env-file=.env.local scripts/slack/login-slack-cli.mjs",
    "slack:cli": "pnpm slack:config-token:refresh && node --env-file=.env.local scripts/slack/run-slack-cli.mjs",
    "slack:app:update": "pnpm slack:config-token:refresh && node --env-file=.env.local scripts/slack/create-dev-app.mjs --environment production --manifest scripts/slack/pantry-dev-manifest.json",
    "slack:public-app:update": "node --env-file=.env.local scripts/slack/create-dev-app.mjs --environment local --manifest scripts/slack/pantry-public-manifest.json",
    "slack:m6:credentials": "pnpm slack:config-token:refresh && node --env-file=.env.local scripts/slack/import-m6-credentials.mjs",
    "cloudflare:organisation-admin-secret": "node --env-file=.env.local scripts/cloudflare/sync-worker-secret.mjs ORGANISATION_ADMIN_TOKEN --env production",
    "cloudflare:slack-ingress-signing-secret": "node --env-file=.env.local scripts/cloudflare/sync-worker-secret.mjs SLACK_SIGNING_SECRET --worker slack-ingress --env production",
    "cloudflare:commerce-lab-secret": "node --env-file-if-exists=.env.local scripts/cloudflare/sync-worker-secret.mjs COMMERCE_LAB_SIGNING_SECRET --generate --env production",
    "cloudflare:fault-injection-secret": "node --env-file-if-exists=.env.local scripts/cloudflare/sync-worker-secret.mjs SATYR_FAULT_INJECTION_TOKEN --generate --env production",
    "cloudflare:fault-injection-secret:delete": "node scripts/cloudflare/delete-worker-secret.mjs SATYR_FAULT_INJECTION_TOKEN --env production",
    "cloudflare:m10:shopify-secrets": "node --env-file=.env.local scripts/cloudflare/sync-worker-secret.mjs SHOPIFY_CLIENT_ID --env production && node --env-file=.env.local scripts/cloudflare/sync-worker-secret.mjs SHOPIFY_CLIENT_SECRET --env production",
    "slack:m6:recovery": "pnpm --filter @seams/platform test:m6-recovery",
    "stripe:m7:credentials": "node --env-file-if-exists=.env.local scripts/slack/import-m7-stripe-credential.mjs",
    "stripe:m10:oauth-config": "node scripts/stripe/setup-m10-connect.mjs && node --env-file=.env.local scripts/stripe/setup-m10-connect-webhook.mjs",
    "stripe:m10:webhook-config": "node --env-file=.env.local scripts/stripe/setup-m10-connect-webhook.mjs",
    "shopify:m7:credentials": "node --env-file-if-exists=.env.local scripts/slack/import-m7-shopify-credential.mjs",
    "shopify:m8:credentials": "node --env-file-if-exists=.env.local scripts/slack/import-m8-shopify-local-credentials.mjs",
    "shopify:m8:automation-token": "node scripts/slack/import-m8-shopify-automation-token.mjs",
    "shopify:m8:link": "node --env-file=.env.local scripts/slack/link-m8-shopify-app.mjs",
    "shopify:m8:deploy": "node --env-file=.env.local scripts/slack/deploy-m8-shopify-app.mjs",
    "identity:m7:roles": "node --env-file=.env.local scripts/slack/manage-m7-person-roles.mjs",
    "lab:reset": "node --env-file-if-exists=.env.local scripts/lab/run-commerce-lab.mjs reset",
    "lab:seed": "node --env-file-if-exists=.env.local scripts/lab/run-commerce-lab.mjs seed",
    "lab:scenario": "node --env-file-if-exists=.env.local scripts/lab/run-commerce-lab.mjs scenario happy-order",
    "lab:verify": "node --env-file-if-exists=.env.local scripts/lab/run-commerce-lab.mjs verify",
    "plan9:16:local": "pnpm --filter @seams/platform exec vitest run tests/commerce-loop.test.ts tests/commerce-actions.test.ts tests/commerce-provider-execution.test.ts tests/commerce-control-router.test.ts tests/plan15-case-walking-path.test.ts tests/agent-operations.test.ts tests/action-ledger.test.ts tests/control-oidc.test.ts && pnpm portal:build",
    "slack:ingress": "node scripts/slack/run-local-event-tunnel.mjs local",
    "test:environments": "node --test scripts/worker-environment.test.mjs && pnpm --filter @seams/platform exec vitest run tests/environment-configuration.test.ts",
    "lint": "pnpm lint:state-machines && pnpm lint:state-writers && pnpm lint:purge-catalogue && pnpm lint:provider-workflows && pnpm lint:ifc-boundaries && pnpm lint:runtime-boundary && pnpm lint:commerce-spec && pnpm lint:d1-patch && pnpm lint:file-size && pnpm lint:portal-fetch && pnpm lint:portal-select && pnpm lint:database-handles && pnpm lint:physics-bundle && pnpm lint:appliance-registry && pnpm lint:journey-index",
    "lint:fix": "pnpm lint:provider-workflows --fix",
    "lint:provider-workflows": "eslint services/platform/src/provider-workflows",
    "lint:ifc-boundaries": "node scripts/check-ifc-destinations.mjs && eslint services/platform/src apps/portal/src --rule 'curly: off' --rule 'one-var: off' --rule '@stylistic/padding-line-between-statements: off'",
    "lint:runtime-boundary": "node scripts/check-runtime-boundary.mjs",
    "lint:state-machines": "node scripts/check-state-machines.mjs",
    "lint:commerce-spec": "node scripts/check-commerce-spec.mjs",
    "lint:d1-patch": "node scripts/check-d1-patch.mjs",
    "lint:file-size": "node scripts/check-file-size-ratchet.mjs",
    "lint:journey-index": "node scripts/production-simulation/run-journeys.mjs --check",
    "lint:portal-fetch": "node scripts/check-portal-fetch-ratchet.mjs",
    "lint:portal-select": "node scripts/check-portal-select.mjs",
    "lint:database-handles": "node scripts/check-database-handles.mjs",
    "lint:physics-bundle": "node scripts/check-physics-bundle.mjs",
    "lint:appliance-registry": "node scripts/bakery-robots/appliance-registry.mjs --check",
    "check:shared-helpers": "node scripts/check-shared-helpers.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "stripe:rotate-connect-secret": "node --env-file=.env.local scripts/stripe/rotate-connect-secret.mjs",
    "lint:state-writers": "node scripts/check-state-writers.mjs",
    "lint:purge-catalogue": "node scripts/check-purge-catalogue.mjs"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.10.0",
    "@typescript-eslint/parser": "8.70.0",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "5.9.3"
  }
}
