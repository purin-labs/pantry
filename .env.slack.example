# Local Slack/Cloudflare acceptance configuration.
# Copy to .env.local. Never commit real values.

PANTRY_WORKER_URL=https://pantry.purin.io
PANTRY_PLATFORM_MODEL=gpt-5.5
SLACK_APP_ID=A0BFVDZLFLM
SLACK_TEAM_ID=T0BGQSSG45N
PANTRY_SLACK_CHANNEL_ID=C0BG0P4JF25
SLACK_BOT_USER_ID=U0BFWR9EF54

# Managed by pnpm slack:m6:credentials and slack:config-token:refresh.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_USER_ID=
ORGANISATION_ADMIN_TOKEN=

# Optional M7 acceptance overrides. Defaults to SLACK_USER_ID and organisation_<SLACK_TEAM_ID>.
M7_OPERATOR_SLACK_USER_ID=
M7_OPERATOR_DISPLAY_NAME=
M7_ORGANISATION_ID=

# Optional M7/M8 Shopify typed actions and cues. Provider secrets are prompted by default.
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Optional for manifest updates; unused by slack:m6:quick/full.
# Managed by pnpm slack:config-token:import/refresh.
SLACK_APP_CONFIG_TOKEN=
SLACK_APP_CONFIG_REFRESH_TOKEN=

# Optional M9 portable-thread bindings.
M9_ORGANISATION_ID=
M9_THREAD_ID=thread_test_commerce
M9_OWNER_PERSON_ID=
M9_SLACK_THREAD_TS=
DISCORD_CHANNEL_ID=
DISCORD_WEBHOOK_URL=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
GDRIVE_FILE_ID=
GDRIVE_FILENAME=
GDRIVE_ACCESS_TOKEN=
DROPBOX_PATH=
DROPBOX_ACCESS_TOKEN=
DROPBOX_APP_SECRET=

# Optional stable token for retrying an M9 provider acceptance command.
M9_ACCEPTANCE_TOKEN=
